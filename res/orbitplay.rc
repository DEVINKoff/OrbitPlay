#include <winuser.h>
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "orbitplay.manifest"

1 VERSIONINFO
FILEVERSION 1,6,1,0
PRODUCTVERSION 1,6,1,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Orbit Play - PS5 Remote Play"
      VALUE "ProductName", "Orbit Play"
      VALUE "FileVersion", "1.6.1"
      VALUE "ProductVersion", "1.6.1"
      VALUE "LegalCopyright", "AGPL-3.0. Uses chiaki-ng."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

// IBM Plex Sans (SIL Open Font License, see fonts/OFL.txt)
101 RCDATA "fonts/IBMPlexSans-Light.ttf"
102 RCDATA "fonts/IBMPlexSans-Regular.ttf"
103 RCDATA "fonts/IBMPlexSans-Medium.ttf"
104 RCDATA "fonts/IBMPlexSans-SemiBold.ttf"
