#include <winuser.h>
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "orbitplay.manifest"

1 VERSIONINFO
FILEVERSION 1,5,0,0
PRODUCTVERSION 1,5,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Orbit Play - PS5 Remote Play"
      VALUE "ProductName", "Orbit Play"
      VALUE "FileVersion", "1.5.0"
      VALUE "ProductVersion", "1.5.0"
      VALUE "LegalCopyright", "AGPL-3.0. Uses chiaki-ng."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
